rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authorization
    function isManager() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    // Publicly Readable Content (Managed by Managers)
    match /plans/{document=**} { allow read: if true; allow write: if isManager(); }
    match /partners/{document=**} { allow read: if true; allow write: if isManager(); }
    match /testimonials/{document=**} { allow read: if true; allow write: if isManager(); }
    match /careers/{document=**} { allow read: if true; allow write: if isManager(); }
    match /gallery/{document=**} { allow read: if true; allow write: if isManager(); }
    match /faqs/{document=**} { allow read: if true; allow write: if isManager(); }
    match /blogs/{document=**} { allow read: if true; allow write: if isManager(); }
    match /settings/{document=**} { allow read: if true; allow write: if isManager(); }

    // Public Ingestion (Users can create, but only Managers can read/manage)
    match /appointments/{document=**} { 
      allow create: if true; 
      allow read, update, delete: if isManager(); 
    }
    match /tickets/{document=**} { 
      allow create: if true; 
      allow read, update, delete: if isManager(); 
    }
    match /calculatorHistory/{document=**} { 
      allow create: if true; 
      allow read, update, delete: if isManager(); 
    }

    // User Profiles
    match /users/{userId} {
      // Users can read their own profile, but only Managers can read/manage all users
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isManager();
      
      // Allow creation of profile only if role is NOT 'manager'
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role != 'manager';
                    
      // Allow updates to own profile only if role is unchanged
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
    }

    // Private Business Data (Strictly Manager Only)
    match /claims/{document=**} { allow read, write: if isManager(); }
    match /policies/{document=**} { allow read, write: if isManager(); }
    match /documents/{document=**} { allow read, write: if isManager(); }
    match /customers/{document=**} { allow read, write: if isManager(); }
    match /logs/{document=**} { allow read, write: if isManager(); }
    match /notifications/{document=**} { allow read, write: if isManager(); }
  }
}
